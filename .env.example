# Docker Compose (PostgreSQL)
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair_pass
POSTGRES_DB=repair_system
POSTGRES_PORT=5433

# Prisma
DATABASE_URL="postgresql://repair:repair_pass@localhost:5433/repair_system?schema=public"

# NextAuth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Development: take the site URL from the request, so the app also works when
# opened from a phone on the LAN (e.g. http://192.168.1.10:3000) to take photos.
AUTH_TRUST_HOST=true
# Production: set the real public URL instead (it takes precedence).
# NEXTAUTH_URL="https://repair.example.com"

# Where uploaded repair photos are stored (relative to project root)
UPLOAD_DIR="uploads"
