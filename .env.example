# Docker Compose (PostgreSQL)
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair_pass
POSTGRES_DB=repair_system
POSTGRES_PORT=5433

# Prisma
DATABASE_URL="postgresql://repair:repair_pass@localhost:5433/repair_system?schema=public"

# NextAuth — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Where uploaded repair photos are stored (relative to project root)
UPLOAD_DIR="uploads"
