# Docker Compose (PostgreSQL)
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair_pass
POSTGRES_DB=repair_system
POSTGRES_PORT=5433

# Prisma — the app uses DATABASE_URL (pooled on Neon); migrations and seeds use
# DATABASE_URL_UNPOOLED when it is set (Neon's Vercel integration adds both).
DATABASE_URL="postgresql://repair:repair_pass@localhost:5433/repair_system?schema=public"
# DATABASE_URL_UNPOOLED=""

# NextAuth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Development: take the site URL from the request, so the app also works when
# opened from a phone on the LAN (e.g. http://192.168.1.10:3000) to take photos.
# (Not needed on Vercel, which is detected automatically.)
AUTH_TRUST_HOST=true
# Self-hosted production: set the real public URL instead (it takes precedence).
# NEXTAUTH_URL="https://repair.example.com"

# Photo storage. Locally photos go to this folder. On Vercel, connect a *private*
# Blob store to the project instead — Vercel then provides BLOB_STORE_ID (and
# BLOB_READ_WRITE_TOKEN) and photos are stored there automatically.
UPLOAD_DIR="uploads"

# Web Push notifications to phones/desktops (optional — leave empty to turn off).
# Generate a key pair with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact address for the push services (mailto: or https:).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
