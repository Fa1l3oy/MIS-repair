generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MAINTENANCE
  ADMIN
}

enum RequestStatus {
  PENDING // รอรับเรื่อง
  ACCEPTED // รับเรื่องแล้ว
  IN_PROGRESS // กำลังดำเนินการ
  ON_HOLD // รออะไหล่ / พักงาน
  COMPLETED // ซ่อมเสร็จ
  REJECTED // ไม่สามารถดำเนินการได้
  CANCELLED // ผู้แจ้งยกเลิก
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ImageKind {
  BEFORE // รูปที่ผู้แจ้งถ่ายตอนแจ้ง
  AFTER // รูปหลังซ่อมโดยช่าง
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENT
  RATED
}

/// Text limits and formats are also enforced by CHECK constraints (migration
/// field_limits) — see src/lib/limits.ts.
model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254) // stored lower-case
  passwordHash String   @db.VarChar(100) // bcrypt
  role         Role     @default(USER)
  phone        String?  @db.VarChar(10) // digits only, e.g. 0812345678
  department   String?  @db.VarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportedRequests  RepairRequest[]    @relation("Reporter")
  assignedRequests  RepairRequest[]    @relation("Assignee")
  activities        RequestActivity[]
  uploadedImages    RepairImage[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

model Building {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  code      String?  @db.VarChar(10) // e.g. B01
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests RepairRequest[]
  qrTags   QrTag[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests RepairRequest[]
  qrTags   QrTag[]
}

/// A printed QR sticker for a place or asset. Scanning /q/<id> opens the
/// report form with these details filled in.
model QrTag {
  id          String   @id // short random code used in the QR URL
  equipment   String?  @db.VarChar(150)
  assetNumber String?  @db.VarChar(50)
  floor       Int?     @db.SmallInt // -5 … 99 (0 = G, negative = basement)
  location    String   @db.VarChar(150)
  createdAt   DateTime @default(now())

  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  requests RepairRequest[]
}

model RepairRequest {
  id          String        @id @default(cuid())
  code        String        @unique @db.VarChar(20) // เลขที่ใบแจ้งซ่อม เช่น RP-202609-0001
  equipment   String        @db.VarChar(150) // ชื่ออุปกรณ์ที่เสียหาย
  assetNumber String?       @db.VarChar(50) // เลขครุภัณฑ์
  description String        @db.VarChar(2000)
  floor       Int?          @db.SmallInt // ชั้น -5 … 99 (0 = G, ติดลบ = ชั้นใต้ดิน)
  location    String        @db.VarChar(150) // ห้อง / จุดที่ตั้ง
  priority    Priority      @default(MEDIUM)
  status      RequestStatus @default(PENDING)
  rating      Int?          @db.SmallInt // 1-5 คะแนนความพึงพอใจหลังซ่อมเสร็จ
  feedback    String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  assigneeId String?
  assignee   User?    @relation("Assignee", fields: [assigneeId], references: [id])
  qrTagId    String? // set when reported by scanning a QR sticker
  qrTag      QrTag?   @relation(fields: [qrTagId], references: [id], onDelete: SetNull)

  images     RepairImage[]
  activities RequestActivity[]

  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
}

model RepairImage {
  id        String    @id @default(cuid())
  filename  String    @unique @db.VarChar(100)
  mimeType  String    @db.VarChar(50)
  size      Int // bytes, at most 8 MB
  kind      ImageKind @default(BEFORE)
  createdAt DateTime  @default(now())

  requestId    String
  request      RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
}

model RequestActivity {
  id         String         @id @default(cuid())
  type       ActivityType
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  message    String?        @db.VarChar(2000)
  createdAt  DateTime       @default(now())

  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User          @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
}

/// Failed-login counter per account (see src/lib/login-throttle.ts). Kept in the
/// database because serverless instances don't share memory.
model LoginThrottle {
  key      String   @id @db.VarChar(254) // normalised email
  failures Int      @default(0)
  resetAt  DateTime
}

model Notification {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  message   String   @db.VarChar(2000)
  link      String?  @db.VarChar(300) // internal path, e.g. /requests/…
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

/// A browser/device that receives Web Push notifications for a user.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.VarChar(2048) // push-service URL; one row per browser
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
